generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ResourceType {
  IMAGE
  VIDEO
  RAW
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NOT_REQUESTED
}

enum CaptureSource {
  WEB_UPLOAD
  WEB_LIVE_CAPTURE
  APP_CAPTURE
}

/// Wording matters in the field: nothing is ever called fraud, only "needs a second look".
enum TrustStatus {
  NOT_ASSESSED
  STRONG
  MODERATE
  NEEDS_SECOND_LOOK
}

enum TrustResult {
  PASS
  INFO
  WARN
  FAIL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  RESHOOT_REQUESTED
}

enum ReportType {
  IMPACT_SUMMARY
  PROJECT_UPDATE
  DONOR_REPORT
  CAMPAIGN_BRIEF
  CUSTOM
}

enum OrgRole {
  OWNER
  ADMIN
  PROGRAM_MANAGER
  VERIFIER
  FIELD_WORKER
  VIEWER
}

enum OrgType {
  NGO
  CSR
  GOVERNMENT
  SOCIAL_ENTERPRISE
  OTHER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  organizationName   String?
  role               String?
  projects           Project[]
  memberships        Membership[]
  projectAssignments ProjectMember[] @relation("ProjectAssignee")
  uploadedAssets     Asset[]         @relation("AssetUploader")
  devices            Device[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

/// A tenant. Every project, and through it every asset, comparison and report,
/// belongs to exactly one organization; nothing is shared across organizations.
model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  type        OrgType      @default(NGO)
  logoUrl     String?
  /// Auto-created for a user at sign-up (or for pre-organization accounts).
  personal    Boolean      @default(false)
  createdById String?
  memberships Membership[]
  invites     Invite[]
  projects    Project[]
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SHA-256 of the normalized code; the code itself is shown once and never stored.
  codeHash       String       @unique
  /// Last characters of the code so admins can tell invites apart.
  codeHint       String
  role           OrgRole
  /// When set, only a user with this email can redeem the invite.
  email          String?
  expiresAt      DateTime
  maxUses        Int          @default(1)
  usedCount      Int          @default(0)
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Assignment of a member to a project. Program managers, verifiers and field
/// workers only see projects they are assigned to.
model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ProjectAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  createdAt    DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// Append-only, hash-chained per organization: each entry's hash covers the
/// previous entry's hash, so editing or deleting history breaks the chain.
model AuditLog {
  id             String       @id @default(cuid())
  seq            Int          @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  prevHash       String?
  hash           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, seq])
}

model Project {
  id             String          @id @default(cuid())
  /// The user who created the project. Access is decided by organization membership.
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  sites          Site[]
  eventClusters  EventCluster[]
  name           String
  description    String?
  location       String?
  category       String?
  status         ProjectStatus   @default(PLANNING)
  startDate      DateTime
  endDate        DateTime?
  coverImage     String?
  assets         Asset[]
  comparisons    Comparison[]
  reports        Report[]
  insight        ProjectInsight?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId, updatedAt])
  @@index([organizationId, updatedAt])
}

model Asset {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String         @unique
  cloudinaryAssetId  String?        @unique
  resourceType       ResourceType
  secureUrl          String
  originalFilename   String
  width              Int?
  height             Int?
  bytes              Int?
  format             String?
  capturedAt         DateTime?
  latitude           Float?
  longitude          Float?
  locationName       String?
  activity           String?
  description        String?
  aiStatus           AnalysisStatus @default(NOT_REQUESTED)
  analysisError      String?
  analysisAttempts   Int            @default(0)
  analysisStartedAt  DateTime?
  uploadedById       String?
  uploadedBy         User?          @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  lastAnalyzedAt     DateTime?
  favorite           Boolean        @default(false)
  // Trust layer: provenance captured at upload, then explained checks.
  captureSource      CaptureSource  @default(WEB_UPLOAD)
  sha256             String?
  /// 64-bit perceptual hash from Cloudinary (hex).
  phash              String?
  /// Parsed from the original bytes on our server, never from display strings.
  exif               Json?
  /// Raw upload-time analysis returned by Cloudinary (quality, faces, colors).
  cloudinaryAnalysis Json?
  qualityScore       Float?
  faceCount          Int?
  /// Where capturedAt came from: EXIF, STAMP, DEVICE, SERVER.
  capturedAtSource   String?
  /// Where latitude/longitude came from: EXIF, STAMP, DEVICE.
  locationSource     String?
  gpsAccuracyM       Float?
  /// Free-text "captured by" for a coordinator uploading on behalf of field staff.
  capturedByName     String?
  trustScore         Int?
  trustStatus        TrustStatus    @default(NOT_ASSESSED)
  trustEvaluatedAt   DateTime?
  reviewStatus       ReviewStatus   @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?
  /// Opaque token for the public Evidence Passport; null until shared.
  publicToken        String?        @unique
  siteId             String?
  site               Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  eventClusterId     String?
  eventCluster       EventCluster?  @relation(fields: [eventClusterId], references: [id], onDelete: SetNull)
  trustChecks        TrustCheck[]
  analysis           AssetAnalysis?
  beforeComparisons  Comparison[]   @relation("BeforeAsset")
  afterComparisons   Comparison[]   @relation("AfterAsset")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, capturedAt])
  @@index([aiStatus])
  @@index([sha256])
  @@index([projectId, reviewStatus])
  @@index([eventClusterId])
}

/// A named place inside a project, checked as centre + radius.
model Site {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  latitude  Float
  longitude Float
  radiusM   Int      @default(500)
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Media captured close together in time and place: "40 photos, 1 event".
model EventCluster {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedAt         DateTime
  endedAt           DateTime
  latitude          Float?
  longitude         Float?
  assetCount        Int      @default(0)
  /// Up to three best shots, chosen by quality.
  representativeIds Json     @default("[]")
  label             String?
  assets            Asset[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId, startedAt])
}

/// One explained check behind a Trust Score. Score, badge and passport all read these rows.
model TrustCheck {
  id             String      @id @default(cuid())
  assetId        String
  asset          Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  check          String
  result         TrustResult
  /// Points this check moved the score (negative for penalties).
  weight         Int         @default(0)
  hard           Boolean     @default(false)
  message        String
  details        Json?
  relatedAssetId String?
  createdAt      DateTime    @default(now())

  @@index([assetId])
}

/// A file generated from evidence (card, poster, blurred copy) and the exact
/// Cloudinary transformation that produced it, so it can be reproduced.
model DerivedAsset {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  sourceAssetIds Json
  kind           String
  transformation String
  url            String
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([projectId])
}

model AssetAnalysis {
  id                    String   @id @default(cuid())
  assetId               String   @unique
  asset                 Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  summary               String
  detailedDescription   String?
  activity              String
  projectCategoryHints  Json?
  locationType          String?
  visibleSubjects       Json?
  environmentalSignals  Json
  infrastructureSignals Json?
  detectedObjects       Json
  tags                  Json
  visualQuality         String?
  evidenceStrength      String?
  evidenceUsefulness    String?
  uncertainties         Json?
  representativeFrames  Json?
  /// Recapture / synthetic likelihood and any burned-in GPS camera stamp read by the vision model.
  authenticity          Json?
  confidence            Float?
  analysisVersion       Int      @default(2)
  rawResponse           Json?
  model                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ProjectInsight {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary               String
  documentedActivities  Json
  locationsRepresented  Json
  timeSpan              String
  recurringObservations Json
  evidenceGaps          Json
  recentActivity        String
  uncertaintyNotes      Json
  sourceEvidenceCount   Int
  model                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Comparison {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  beforeAssetId String
  beforeAsset   Asset    @relation("BeforeAsset", fields: [beforeAssetId], references: [id], onDelete: Restrict)
  afterAssetId  String
  afterAsset    Asset    @relation("AfterAsset", fields: [afterAssetId], references: [id], onDelete: Restrict)
  summary       String?
  changes       Json?
  confidence    Float?
  createdAt     DateTime @default(now())

  @@unique([beforeAssetId, afterAssetId])
  @@index([projectId, createdAt])
}

model Report {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  reportType ReportType
  content    Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([projectId, updatedAt])
}

/// A phone enrolled for live capture. Its Ed25519 public key verifies that a
/// capture's file and facts were signed on this device and not changed since.
model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Raw 32-byte Ed25519 public key, base64.
  publicKey  String
  platform   String
  model      String?
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
