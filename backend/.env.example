# PostgreSQL. Tests use a separate database named <name>_test (see README).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fieldproof?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/fieldproof?schema=public"
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET="replace-with-at-least-32-random-characters"

# Cloudinary: storage, upload-time analysis (phash, quality, faces) and every transformation.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Groq vision model for evidence analysis, search intent, comparisons and reports.
GROQ_API_KEY=""
AI_MODEL="qwen/qwen3.8-27b"
# Calls are paced to stay under the provider's tokens-per-minute limit.
AI_TOKENS_PER_MINUTE=7000

# The web app's public origin. Also used in QR codes on campaign cards, so set
# it to the deployed URL before generating anything you will share.
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://127.0.0.1:4173"
# lax when the web app and API share a domain; none only for cross-domain deploys (forces Secure).
COOKIE_SAME_SITE="lax"
# EXIF capture times carry no zone; this offset is assumed when the camera did not record one.
EXIF_DEFAULT_UTC_OFFSET="+05:30"

PORT=4000
NODE_ENV="development"

# Outgoing email for member setup links and password resets (any SMTP provider).
# Leave empty to show setup links in the admin UI instead of emailing them.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FieldProof <no-reply@yourdomain.org>"
